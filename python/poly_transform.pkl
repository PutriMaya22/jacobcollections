# generate_model.py
import pandas as pd
import numpy as np
from sklearn.preprocessing import PolynomialFeatures
from sklearn.linear_model import LinearRegression
import joblib

# Contoh data historis
data = pd.read_excel("datapenjualan.xlsx")  # kolom: total_sales
data = data.dropna(subset=['total_sales', 'total_orders'])
X = np.array([[d.day, d.month, d.weekday(), 1 if d.weekday() >= 5 else 0] for d in pd.to_datetime(data['date'])])
y = data['total_sales'].values

# Polynomial transform
poly = PolynomialFeatures(degree=2)
X_poly = poly.fit_transform(X)

# Model regresi
model = LinearRegression()
model.fit(X_poly, y)

# Simpan
joblib.dump(poly, "poly_transform.pkl")
joblib.dump(model, "sales_prediction_model.pkl")
